{
	"name": "wp-forms-blocks",
	"version": "0.1.0",
	"description": "Block-editor forms with email, custom actions, comments, and privacy requests.",
	"author": "Aristeidis Stathopoulos",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"blocks",
		"forms",
		"gutenberg"
	],
	"homepage": "https://github.com/aristath/wp-forms-blocks",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/aristath/wp-forms-blocks.git"
	},
	"bugs": "https://github.com/aristath/wp-forms-blocks/issues",
	"private": true,
	"engines": {
		"node": ">=20.19.0",
		"npm": ">=10.2.3"
	},
	"packageManager": "pnpm@10.28.1",
	"dependencies": {
		"@wordpress/block-editor": "^17.1.0",
		"@wordpress/blocks": "^16.0.0",
		"@wordpress/components": "^40.1.0",
		"@wordpress/compose": "^8.8.0",
		"@wordpress/data": "^10.55.0",
		"@wordpress/dom": "^4.55.0",
		"@wordpress/element": "^8.7.0",
		"@wordpress/hooks": "^4.55.0",
		"@wordpress/i18n": "^6.28.0",
		"@wordpress/icons": "^16.0.0",
		"@wordpress/primitives": "^4.55.0",
		"clsx": "^2.1.1",
		"remove-accents": "^0.5.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@wordpress/babel-preset-default": "^8.55.0",
		"@wordpress/block-library": "^11.0.0",
		"@wordpress/block-serialization-default-parser": "^5.55.0",
		"@wordpress/e2e-test-utils-playwright": "^2.0.0",
		"@wordpress/jest-preset-default": "^14.2.0",
		"@wordpress/prettier-config": "^4.55.0",
		"@wordpress/scripts": "^35.0.0",
		"lefthook": "2.1.14",
		"prettier": "npm:wp-prettier@^3.0.3",
		"react": "^19.3.0",
		"react-dom": "^19.3.0"
	},
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php",
		"format": "npm run format:js && npm run format:php",
		"format:js": "wp-scripts format",
		"format:php": "composer format",
		"gate:commit": "npm run lint && npm run verify:build && npm run lint:plugin && npm test",
		"i18n:make-pot": "wp i18n make-pot . languages/wp-forms-blocks.pot --exclude=artifacts,build,coverage,node_modules,tests,vendor",
		"lint": "npm run lint:format && npm run lint:js && npm run lint:css && npm run lint:md && npm run lint:pkg-json && npm run lint:i18n && npm run lint:lefthook && npm run lint:php && npm run lint:phpstan",
		"lint:css": "wp-scripts lint-style 'src/**/*.scss'",
		"lint:format": "prettier --check '**/*.{cjs,js,json,jsx,mjs,ts,tsx,yml,yaml}'",
		"lint:i18n": "tests/check-pot.sh",
		"lint:js": "wp-scripts lint-js src tests/js specs webpack.config.js jest-unit.config.js playwright.config.js",
		"lint:lefthook": "lefthook validate",
		"lint:md": "wp-scripts lint-md-docs",
		"lint:php": "composer lint",
		"lint:phpstan": "composer analyse",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"lint:plugin": "npm run plugin-zip && tests/run-plugin-check.sh",
		"plugin-zip": "wp-scripts plugin-zip",
		"prepare": "lefthook install",
		"start": "wp-scripts start --webpack-copy-php",
		"test": "npm run test:coverage && npm run test:php && npm run test:wordpress && npm run test:e2e",
		"test:e2e": "tests/run-e2e-tests.sh",
		"test:fixtures": "wp-scripts test-unit-js tests/js/serialization.test.js --runInBand",
		"test:php": "composer test",
		"test:unit": "wp-scripts test-unit-js --runInBand",
		"test:coverage": "wp-scripts test-unit-js --runInBand --coverage",
		"test:wordpress": "tests/run-wordpress-tests.sh",
		"verify:build": "npm run build && git diff --exit-code -- build"
	}
}
